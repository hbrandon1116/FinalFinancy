# FinanzasPro backend environment variables.
#
# Copy this file to .env and replace the placeholders. Never commit .env or real
# credentials. Environment variables already set by the process take precedence.

# Django. In production, DJANGO_SECRET_KEY must have at least 32 characters
# and must not contain placeholders or example values.
DJANGO_SECRET_KEY=replace-with-a-secure-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Required in production and must use a postgresql:// or
# postgres:// URL. Set DATABASE_URL in your local .env, never in this template.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# Browser origins allowed to call the API with credentials. Required in
# production; use exact origins with no trailing slash and no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# CSRF cookie policy. Use a value compatible with the frontend/backend domains.
CSRF_COOKIE_SAMESITE=Lax

# JWT lifetimes. Access is expressed in minutes; refresh in days.
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7
# Optional; defaults to DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=

# Refresh cookie settings. Use true/Secure in production.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# Financial write idempotency window.
IDEMPOTENCY_TTL_HOURS=24
