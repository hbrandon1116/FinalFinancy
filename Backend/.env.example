# FinanzasPro backend environment variables.
#
# Copy this file to .env and replace the placeholders. Never commit .env or real
# credentials. Environment variables already set by the process take precedence.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Replace usuario and clave with the local database credentials.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/finanzaspro
DATABASE_CONN_MAX_AGE=60

# Browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT lifetimes. Access is expressed in minutes; refresh in days.
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7
# Optional; defaults to DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=

# Refresh cookie settings. Use true/Secure in production.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# Financial write idempotency window.
IDEMPOTENCY_TTL_HOURS=24
