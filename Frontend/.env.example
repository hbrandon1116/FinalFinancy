# Variables de entorno del frontend de Final-Financy.
#
# Copia este archivo como ".env" y ajusta los valores según tu entorno local.
# Las variables deben ir siempre con el prefijo VITE_ para que Vite las exponga
# al frontend. No guardes aquí contraseñas ni claves privadas.

# URL base de la API de Django REST Framework.
VITE_API_URL=http://localhost:8000/api